# ====================================================================
# QUICKUPP AI STUDIO - DUAL DATABASE & SERVER ENVIRONMENT CONFIG
# ====================================================================

# 1. LOCAL DATABASE (PostgreSQL on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# 2. INDIA SUPABASE (its OWN project — never the US project)
# The US site keeps the original Supabase project; India uses a separate one.
# The app refuses to start DB calls if these point at the US project.
IND_SUPABASE_URL=
IND_SUPABASE_SERVICE_KEY=

# 3. EMAIL NOTIFICATIONS (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_USER=qsaistudio@gmail.com
SMTP_PASS=your-16-letter-gmail-app-password
# Optional second route, used if Gmail fails (Hostinger mailbox):
HOSTINGER_SMTP_USER=info@quickuppaistudio.in
HOSTINGER_SMTP_PASS=your-mailbox-password

# 4. CRM SECURITY (optional — sensible defaults are used if not set)
# Secret used to sign CRM login sessions (any long random string)
CRM_SESSION_SECRET=
# PIN that unlocks the Orders & Payments tab (default: Admin@8080)
CRM_PAYMENTS_PIN=

# 5. PAYU (India payments) — checkout works without these; orders are saved as PENDING
#    and the team sends a payment link. Add them to switch on online payment.
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=test
PUBLIC_SITE_URL=https://quickuppaistudio.in

# 6. WHATSAPP NEW-LEAD ALERTS (optional — the lead email works without these)
#    Option A, official: Meta WhatsApp Cloud API (template "new_lead_alert", 7 variables)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
#    Option B, free personal use: CallMeBot API key
CALLMEBOT_APIKEY=
#    Who receives the alerts (comma-separated for several numbers)
LEAD_WHATSAPP_TO=918055679162
